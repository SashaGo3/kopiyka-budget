!.env.example
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# private notes (App Store submission details, anything with personal data)
docs/private/

# regenerable screenshot captures (the framed App Store set is committed)
apps/mobile/screenshots/raw/

# OS noise
.DS_Store
