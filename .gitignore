# dependencies / build output
node_modules/
dist/
.expo/
apps/mobile/ios/
apps/mobile/android/
apps/mobile/build/
*.tsbuildinfo

# local databases and personal data — never commit a real export
*.db
*.db-*
data/
*.csv
