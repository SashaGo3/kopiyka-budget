index 7fe775e25f5c01a512c7d4380ddf0cc3d0e7e544..22ce9ad92dc688b3065ad82fbfe0f89801d2303b 100644
--- a/ios/Core/AppContext.swift
+++ b/ios/Core/AppContext.swift
@@ -162,6 +162,7 @@ public final class AppContext: NSObject, EXAppContextProtocol, @unchecked Sendab
     self.config = config ?? AppContextConfig(documentDirectory: nil, cacheDirectory: nil, appGroups: appCodeSignEntitlements.appGroups)
 
     super.init()
+    AppContext.noteLive(self)
 
     self.moduleRegistry.register(module: JSLoggerModule(appContext: self), name: nil)
     listenToClientAppNotifications()
@@ -697,6 +698,34 @@ public final class AppContext: NSObject, EXAppContextProtocol, @unchecked Sendab
     _runtime = nil
   }
 
+  // MARK: - Live contexts (patched: Kopiyka)
+
+  /**
+   Every app context created in this process, newest last, held weakly. Fabric view classes are
+   created once per process (React Native's component view factory is a singleton) and bound to
+   the app context that existed at that time; after a reload in the dev client that context is
+   gone while the class stays, so `ExpoFabricView` falls back to the newest live context here
+   instead of crashing with "The app context has been lost".
+   */
+  private final class WeakContext { weak var value: AppContext?; init(_ v: AppContext) { value = v } }
+  private static let liveLock = NSLock()
+  nonisolated(unsafe) private static var live: [WeakContext] = []
+
+  private static func noteLive(_ context: AppContext) {
+    liveLock.lock(); defer { liveLock.unlock() }
+    live.removeAll { $0.value == nil }
+    live.append(WeakContext(context))
+  }
+
+  /**
+   The most recently created app context that is still alive, if any.
+   */
+  public static var newestLive: AppContext? {
+    liveLock.lock(); defer { liveLock.unlock() }
+    live.removeAll { $0.value == nil }
+    return live.last?.value
+  }
+
   /**
    Cleans things up before deallocation.
    */
