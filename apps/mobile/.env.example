# Copy to apps/mobile/.env (git-ignored). Only needed for device builds, archives and TestFlight uploads;
# simulator builds work without it.

# Your Apple Developer Team ID (Xcode → Settings → Accounts → Team, or developer.apple.com → Membership).
APPLE_TEAM_ID=

# Optional, for `bun run release:ios` without Xcode being signed in: an App Store Connect API key.
#ASC_KEY_PATH=~/.private_keys/AuthKey_XXXXXXXXXX.p8
#ASC_KEY_ID=
#ASC_ISSUER_ID=
